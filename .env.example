COACH_TZ=Asia/Shanghai
# Website listens on loopback. Create a new private password of at least 24 characters.
COACH_WEB_PORT=18797
COACH_WEB_PASSWORD=
# Opt in to sharing this installation's coach conversation with its own Weixin binding.
COACH_WEB_WEIXIN=0
# Relative paths resolve from the project working directory.
COACH_DB=data/coach.sqlite
# Required for real Weixin. Use IDs from the new binding and private gateway log.
COACH_WEIXIN_ACCOUNT=
COACH_WEIXIN_PEER=
# Optional personal API key for manual read-only Intervals.icu sync.
COACH_INTERVALS_API_KEY=
# Optional OpenAI-compatible Chat Completions endpoint (full HTTPS URL).
# Tencent TokenHub Guangzhou: https://tokenhub.tencentmaas.com/v1/chat/completions
# For TokenHub Hy4 Flash use COACH_MODEL_NAME=hy4-flash and a dedicated API key.
COACH_MODEL_URL=
COACH_MODEL_NAME=
COACH_MODEL_KEY=
