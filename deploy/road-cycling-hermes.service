[Unit]
Description=Dedicated Hermes gateway for road cycling coaching
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=road-cycling
Group=road-cycling
WorkingDirectory=/srv/road-cycling-coach
ExecStart=/bin/bash /srv/road-cycling-coach/deploy/hermes.sh gateway run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=35s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
