[Unit]
Description=Private Tailscale access for road cycling coach
Wants=network-online.target
After=network-online.target road-cycling-web.service

[Service]
Type=simple
User=road-cycling
Group=road-cycling
RuntimeDirectory=road-cycling-tailnet
RuntimeDirectoryMode=0700
ExecStart=/var/lib/road-cycling-coach/tailnet/bin/tailscaled --tun=userspace-networking --port=0 --state=/var/lib/road-cycling-coach/tailnet/state --socket=/run/road-cycling-tailnet/tailscaled.sock
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
